{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "servidor-site",
            "type": "shell",
            "command": "python",
            "args": ["-u", "-m", "http.server", "8080"],
            "options": { "cwd": "${workspaceFolder}/flavia-nascimento" },
            "isBackground": true,
            "problemMatcher": {
                "owner": "servidor-site",
                "pattern": { "regexp": "^__nunca__$" },
                "background": {
                    "activesBegin": true,
                    "beginsPattern": "Serving HTTP",
                    "endsPattern": "Serving HTTP"
                }
            }
        }
    ]
}
